# Browser-visible address of the single FastAPI backend.
NEXT_PUBLIC_PROOFLAB_API_URL=http://127.0.0.1:8000

# FastAPI allows requests only from these comma-separated frontend origins.
FRONTEND_ORIGIN=http://localhost:3000

# Server-side teaching provider. Use "local" only for offline UI demos.
AI_PROVIDER=ollama
AI_TIMEOUT_MS=20000

# Ollama: install and run Ollama locally, then pull a model such as
# `ollama pull llama3.2:3b`. This endpoint is never exposed to the browser.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Any Chat Completions-compatible service, including OpenAI when its base URL
# and model are configured. Keep the API key server-side in .env.local.
# AI_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPATIBLE_MODEL=your-model-id
# OPENAI_COMPATIBLE_API_KEY=

# Explicit offline fallback (no model call): AI_PROVIDER=local
